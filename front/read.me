TRANSACCIÓN: 
-- Escenario: transferencia de stock entre 2 productos
BEGIN TRANSACTION;

UPDATE productos
   SET stock = stock - 5
 WHERE id = 1;

UPDATE productos
   SET stock = stock + 5
 WHERE id = 2;

-- Si todo salió bien
COMMIT;

-- Si algo falló
-- ROLLBACK;